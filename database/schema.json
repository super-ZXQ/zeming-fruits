{
  "collections": {
    "users": {
      "indexes": [
        { "keys": { "_openid": 1 }, "options": { "unique": true } },
        { "keys": { "phone": 1 } }
      ],
      "rules": { "read": "doc._openid == auth.openid", "write": false }
    },
    "addresses": {
      "indexes": [
        { "keys": { "_openid": 1, "createdAt": -1 } }
      ],
      "rules": { "read": "doc._openid == auth.openid", "write": false }
    },
    "products": {
      "indexes": [
        { "keys": { "category": 1, "status": 1 } },
        { "keys": { "sales": -1 } }
      ],
      "rules": { "read": true, "write": false }
    },
    "orders": {
      "indexes": [
        { "keys": { "_openid": 1, "createTime": -1 } },
        { "keys": { "_openid": 1, "requestId": 1 }, "options": { "unique": true } },
        { "keys": { "status": 1, "createTime": -1 } }
      ],
      "rules": { "read": "doc._openid == auth.openid", "write": false }
    },
    "settings": { "rules": { "read": true, "write": false } },
    "admins": { "rules": { "read": false, "write": false } },
    "managers": {
      "indexes": [
        { "keys": { "openid": 1 }, "options": { "unique": true } }
      ],
      "rules": { "read": false, "write": false }
    },
    "coupons": { "rules": { "read": false, "write": false } }
  }
}
