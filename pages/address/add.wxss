.container { min-height: 100vh; display: flex; background: #f6f7f2; flex-direction: column; }.map { width: 100%; height: 310rpx; }.map-tip { position: absolute; bottom: 18rpx; left: 50%; padding: 13rpx 20rpx; border-radius: 16rpx; background: rgba(24,92,58,.88); transform: translateX(-50%); }.map-tip text { color: #fff; font-size: 21rpx; }.form-container { padding: 20rpx 24rpx 150rpx; flex: 1; }.section { margin-bottom: 16rpx; padding: 22rpx; border: 1rpx solid #e6ebe4; border-radius: 22rpx; background: #fff; }.address-header { padding: 4rpx 0; }.address-name { display: flex; align-items: center; justify-content: space-between; }.address-name .name { color: #2b4033; font-size: 29rpx; font-weight: 800; }.edit-btn { padding: 8rpx 12rpx; border-radius: 10rpx; background: #eaf3eb; color: #185c3a; font-size: 20rpx; }.distance { display: block; margin-top: 10rpx; color: #8c978f; font-size: 20rpx; }.form-item { display: flex; align-items: center; min-height: 66rpx; }.form-item .label { width: 130rpx; color: #526258; font-size: 24rpx; flex-shrink: 0; }.form-item .input { color: #33483a; font-size: 24rpx; flex: 1; }.form-item .textarea { width: 100%; min-height: 110rpx; padding: 14rpx; border-radius: 14rpx; background: #f5f7f4; color: #33483a; font-size: 23rpx; }.form-tip { padding: 5rpx 0 0 130rpx; }.form-tip text { color: #99a39d; font-size: 19rpx; }.gender-selector, .tags-row { display: flex; gap: 10rpx; flex: 1; }.gender-option, .tag { padding: 10rpx 17rpx; border: 1rpx solid #dfe6df; border-radius: 13rpx; color: #748078; font-size: 21rpx; }.gender-option.active, .tag.active { border-color: #185c3a; background: #185c3a; color: #fff; }.phone-row, .paste-row { display: flex; align-items: center; flex: 1; }.country-code { display: flex; align-items: center; margin-right: 10rpx; padding: 10rpx 12rpx; border-radius: 12rpx; background: #f2f5f2; }.country-code text { color: #526258; font-size: 21rpx; }.country-code .arrow { margin-left: 7rpx; color: #9ca69f; font-size: 15rpx; }.paste-item { flex-wrap: wrap; }.paste-row { width: 100%; }.paste-btn { height: 60rpx; margin-left: 10rpx; padding: 0 17rpx; border-radius: 13rpx; background: #185c3a; color: #fff; font-size: 21rpx; line-height: 60rpx; }.detail-section .form-item { align-items: flex-start; flex-direction: column; }.detail-section .label { margin-bottom: 14rpx; }.footer { position: fixed; right: 0; bottom: 0; left: 0; padding: 16rpx 24rpx; border-top: 1rpx solid #e4e9e3; background: #fff; box-shadow: 0 -8rpx 22rpx rgba(30,61,43,.05); }.save-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 88rpx; border-radius: 20rpx; background: #cbd3cd; color: #fff; font-size: 27rpx; font-weight: 700; }.save-btn.active { background: #185c3a; }
