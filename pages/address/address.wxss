.container { min-height: 100vh; padding: 28rpx 24rpx; background: #f6f7f2; }.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx; }.title { color: #23392d; font-size: 38rpx; font-weight: 800; }.add-btn { display: flex; align-items: center; padding: 15rpx 19rpx; border-radius: 18rpx; background: #185c3a; color: #fff; font-size: 22rpx; }.add-icon { margin-right: 6rpx; font-size: 30rpx; }.address-list { height: calc(100vh - 145rpx); }.address-card { margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid #e6ebe4; border-radius: 24rpx; background: #fff; }.address-card.default { border-color: #8bb79b; box-shadow: 0 8rpx 22rpx rgba(25,88,57,.06); }.card-top { padding-bottom: 20rpx; border-bottom: 1rpx solid #edf0ec; }.user-info, .card-bottom, .actions, .set-default, .default-text { display: flex; align-items: center; }.name { margin-right: 15rpx; color: #2b4033; font-size: 29rpx; font-weight: 800; }.phone { color: #718077; font-size: 24rpx; }.tag { margin-left: 12rpx; padding: 5rpx 10rpx; border-radius: 7rpx; background: #e7f1e9; color: #185c3a; font-size: 18rpx; }.address-detail { margin-top: 12rpx; color: #59685f; font-size: 24rpx; line-height: 1.55; }.card-bottom { justify-content: space-between; padding-top: 18rpx; }.set-default, .default-text { color: #758179; font-size: 21rpx; }.default-text { color: #185c3a; }.set-default icon, .default-text icon { margin-right: 6rpx; }.actions { gap: 12rpx; }.action-btn { padding: 10rpx 16rpx; border: 1rpx solid #dfe5dd; border-radius: 13rpx; color: #66756c; font-size: 21rpx; }.action-btn.delete { border-color: #f1d6d1; color: #c45c50; }.empty { display: flex; align-items: center; padding: 120rpx 0; flex-direction: column; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 128rpx; height: 128rpx; border-radius: 40rpx; background: #e8efe8; font-size: 58rpx; }.empty text { margin-top: 22rpx; color: #68786e; font-size: 25rpx; }.empty-tip { margin-top: 8rpx !important; color: #a0aaa3 !important; font-size: 20rpx !important; }
