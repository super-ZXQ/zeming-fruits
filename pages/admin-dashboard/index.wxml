<view class="container">
  <view class="header"><text class="title">预约管理</text></view>
  <view class="stats-grid">
    <view class="stat-card"><view class="stat-content"><text class="stat-value">¥{{stats.todaySales}}</text><text class="stat-label">今日预估金额</text></view></view>
    <view class="stat-card"><view class="stat-content"><text class="stat-value">{{stats.todayOrders}}</text><text class="stat-label">今日预约</text></view></view>
    <view class="stat-card"><view class="stat-content"><text class="stat-value">{{stats.pendingOrders}}</text><text class="stat-label">待确认</text></view></view>
    <view class="stat-card"><view class="stat-content"><text class="stat-value">{{stats.newUsers}}</text><text class="stat-label">新增顾客</text></view></view>
  </view>

  <view class="section">
    <view class="section-header"><text class="section-title">热销商品 TOP5</text></view>
    <view class="hot-goods" wx:if="{{hotGoods.length}}"><view class="goods-item" wx:for="{{hotGoods}}" wx:key="_id"><view class="goods-rank {{index < 3 ? 'top' : ''}}">{{index + 1}}</view><view class="goods-thumb"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" binderror="onHotImageError" data-index="{{index}}"></image><text wx:else class="image-placeholder">暂无图片</text></view><view class="goods-info"><text class="goods-name">{{item.name}}</text><text class="goods-sales">销量 {{item.totalSales}}</text></view><text class="goods-revenue">¥{{item.totalRevenue}}</text></view></view>
    <text class="empty-text" wx:else>暂无商品数据</text>
  </view>

  <view class="section">
    <view class="section-header column"><text class="section-title">订单列表</text><scroll-view scroll-x class="filter-scroll"><view class="filter-tabs"><view class="filter-tab {{orderFilter === 'all' ? 'active' : ''}}" bindtap="filterOrders" data-filter="all">全部</view><view class="filter-tab {{orderFilter === 'pending' ? 'active' : ''}}" bindtap="filterOrders" data-filter="pending">待确认</view><view class="filter-tab {{orderFilter === 'active' ? 'active' : ''}}" bindtap="filterOrders" data-filter="active">进行中</view><view class="filter-tab {{orderFilter === 'completed' ? 'active' : ''}}" bindtap="filterOrders" data-filter="completed">已完成</view><view class="filter-tab {{orderFilter === 'after_sale' ? 'active' : ''}}" bindtap="filterOrders" data-filter="after_sale">售后</view></view></scroll-view></view>
    <view class="order-list" wx:if="{{orders.length}}">
      <view class="order-item" wx:for="{{orders}}" wx:for-index="orderListIndex" wx:key="_id">
        <view class="order-header"><view class="order-info"><text class="order-index">#{{item.orderIndex}}</text><text class="order-no">{{item.orderNo || item._id}}</text></view><text class="order-status {{item.status}}">{{statusMap[item.status]}}</text></view>
        <view class="order-customer" wx:if="{{item.userInfo}}"><text class="customer-name">{{item.userInfo.nickname}}</text><text class="customer-phone">{{item.userInfo.phone}}</text></view>
        <view class="order-goods"><view class="goods-item" wx:for="{{item.goods}}" wx:for-item="goods" wx:for-index="goodsIndex" wx:key="id"><view class="goods-thumb"><image wx:if="{{goods.imageUrl}}" src="{{goods.imageUrl}}" mode="aspectFill" binderror="onOrderImageError" data-order-index="{{orderListIndex}}" data-goods-index="{{goodsIndex}}"></image><text wx:else class="image-placeholder">暂无图片</text></view><text class="goods-name">{{goods.name}}</text><text class="goods-quantity">×{{goods.quantity}}</text><text class="goods-price">¥{{goods.price}}</text></view></view>
        <view class="order-delivery"><text>{{item.deliveryType === 'pickup' ? '到店自取' : '送货上门'}}</text><text wx:if="{{item.deliveryTime && item.deliveryTime.type === 'schedule'}}"> · {{item.deliveryTime.date}} {{item.deliveryTime.timeSlot}}</text><text wx:else> · 尽快安排</text></view>
        <view class="order-footer"><text class="order-time">{{item.createTimeText}}</text><text class="order-total">¥{{item.priceDetail.total}}</text></view>
        <view class="order-actions"><button wx:if="{{item.nextAction}}" class="btn-advance" catchtap="advanceOrder" data-id="{{item._id}}">{{item.nextAction}}</button><button wx:if="{{item.status === 'pending' || item.status === 'confirmed' || item.status === 'preparing'}}" class="btn-secondary" catchtap="cancelOrder" data-id="{{item._id}}">取消</button><button wx:if="{{item.status === 'after_sale' || item.status === 'refund'}}" class="btn-advance" catchtap="resolveAfterSale" data-id="{{item._id}}">完成售后</button></view>
      </view>
      <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>
    </view>
    <text class="empty-text" wx:else>暂无符合条件的订单</text>
  </view>
</view>
