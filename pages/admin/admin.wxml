<view class="container">
  <view class="header"><text class="header-title">商品管理</text><text class="header-count">共 {{products.length}} 件商品 · 可改价与上下架</text></view>
  <view class="product-list" wx:if="{{products.length > 0}}">
    <view class="product-item" wx:for="{{products}}" wx:key="_id" bindtap="editProduct" data-id="{{item._id}}">
      <view class="product-image"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="product-img" binderror="onImageError" data-index="{{index}}"></image><view wx:else class="product-placeholder"><text class="placeholder-text">🍎</text></view></view>
      <view class="product-info"><view class="product-title-row"><text class="product-name">{{item.name}}</text><text class="product-status {{item.status === 'active' || !item.status ? 'active' : 'inactive'}}">{{item.status === 'active' || !item.status ? '已上架' : '已下架'}}</text></view><view class="product-price-row"><text class="product-price">¥{{item.price}}</text><text class="product-unit">/{{item.unit || '份'}}</text><text class="product-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text></view></view>
      <view class="status-btn {{item.status === 'active' || !item.status ? 'off' : 'on'}}" catchtap="toggleProductStatus" data-id="{{item._id}}" data-status="{{item.status || 'active'}}">{{item.status === 'active' || !item.status ? '下架' : '上架'}}</view>
    </view>
  </view>
  <view class="empty-state" wx:if="{{products.length === 0 && !loading}}"><text class="empty-icon">🍐</text><text class="empty-text">暂无商品</text><text class="empty-tip">点击右下角按钮添加商品</text></view>
  <view class="loading-state" wx:if="{{loading}}"><text class="loading-text">正在加载商品…</text></view>
  <view class="add-btn" bindtap="addProduct">+</view>
</view>

<view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal"></view>
<view class="modal-content" wx:if="{{showModal}}"><view class="modal-header"><text class="modal-title">{{isEdit ? '编辑商品' : '添加商品'}}</text><view class="modal-close" bindtap="closeModal">✕</view></view><scroll-view scroll-y class="modal-body"><view class="form-item"><text class="form-label">商品图片（不超过 200KB）</text><view class="image-upload" bindtap="chooseImage"><image wx:if="{{editForm.imageUrl}}" src="{{editForm.imageUrl}}" mode="aspectFill" class="upload-img"></image><view wx:else class="upload-placeholder"><text class="plus-icon">+</text><text class="upload-tip">选择图片</text></view></view></view><view class="form-item"><text class="form-label">商品名称</text><input class="form-input" placeholder="请输入商品名称" value="{{editForm.name}}" bindinput="onInputName" /></view><view class="form-row"><view class="form-item half"><text class="form-label">现价</text><input class="form-input" type="digit" placeholder="0.00" value="{{editForm.price}}" bindinput="onInputPrice" /></view><view class="form-item half"><text class="form-label">原价</text><input class="form-input" type="digit" placeholder="选填" value="{{editForm.originalPrice}}" bindinput="onInputOriginalPrice" /></view></view><view class="form-item"><text class="form-label">分类</text><picker class="form-input" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="onCategoryChange">{{categories[categoryIndex].name}}</picker></view><view class="form-item"><text class="form-label">单位</text><view class="unit-selector"><view class="unit-option {{editForm.unit === '份' ? 'active' : ''}}" bindtap="selectUnit" data-unit="份">份</view><view class="unit-option {{editForm.unit === '斤' ? 'active' : ''}}" bindtap="selectUnit" data-unit="斤">斤</view><view class="unit-option {{editForm.unit === 'kg' ? 'active' : ''}}" bindtap="selectUnit" data-unit="kg">kg</view><view class="unit-option {{editForm.unit === '个' ? 'active' : ''}}" bindtap="selectUnit" data-unit="个">个</view><view class="unit-option {{editForm.unit === '盒' ? 'active' : ''}}" bindtap="selectUnit" data-unit="盒">盒</view></view></view><view class="form-item"><text class="form-label">标签</text><input class="form-input" placeholder="如：热销、新品" value="{{editForm.tag}}" bindinput="onInputTag" /></view><view class="form-item"><text class="form-label">月销量</text><input class="form-input" type="number" placeholder="0" value="{{editForm.sales}}" bindinput="onInputSales" /></view></scroll-view><view class="modal-footer"><view class="btn-cancel" bindtap="closeModal">取消</view><view class="btn-save" bindtap="saveProduct">保存</view></view></view>
