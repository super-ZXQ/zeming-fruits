.container { min-height: 100vh; padding-bottom: 148rpx; background: #f6f7f2; }.header { display: flex; align-items: flex-end; justify-content: space-between; padding: 44rpx 28rpx 38rpx; background: linear-gradient(145deg, #185c3a, #2a754b); }.header-title { color: #fff; font-size: 38rpx; font-weight: 800; }.header-count { max-width: 340rpx; color: rgba(255,255,255,.72); font-size: 20rpx; line-height: 1.4; text-align: right; }.product-list { padding: 20rpx 24rpx; }.product-item { display: flex; align-items: center; min-height: 120rpx; margin-bottom: 16rpx; padding: 18rpx; border: 1rpx solid #e4ebe3; border-radius: 22rpx; background: #fff; }.product-image { width: 96rpx; height: 96rpx; overflow: hidden; border-radius: 18rpx; background: #edf4ec; flex: 0 0 auto; }.product-img { width: 100%; height: 100%; }.product-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }.placeholder-text { font-size: 46rpx; }.product-info { min-width: 0; margin-left: 18rpx; flex: 1; }.product-title-row { display: flex; align-items: center; }.product-name { max-width: 260rpx; overflow: hidden; color: #2c4034; font-size: 27rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }.product-status { margin-left: 10rpx; padding: 4rpx 9rpx; border-radius: 8rpx; font-size: 18rpx; }.product-status.active { background: #e5f3e8; color: #226840; }.product-status.inactive { background: #f3efec; color: #8b7567; }.product-price-row { display: flex; align-items: baseline; margin-top: 13rpx; }.product-price { color: #d94a3d; font-size: 31rpx; font-weight: 800; }.product-unit, .product-original { margin-left: 6rpx; color: #849087; font-size: 20rpx; }.product-original { text-decoration: line-through; }.status-btn { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 54rpx; margin-left: 12rpx; border-radius: 14rpx; font-size: 21rpx; font-weight: 700; flex: 0 0 auto; }.status-btn.off { border: 1rpx solid #eddfd9; background: #fff8f6; color: #bc554b; }.status-btn.on { border: 1rpx solid #d9eadc; background: #f1f8f1; color: #1c643e; }.empty-state, .loading-state { display: flex; align-items: center; flex-direction: column; padding: 150rpx 0; }.empty-icon { font-size: 92rpx; }.empty-text { margin-top: 18rpx; color: #617168; font-size: 28rpx; font-weight: 700; }.empty-tip, .loading-text { margin-top: 10rpx; color: #94a097; font-size: 22rpx; }.add-btn { position: fixed; right: 28rpx; bottom: 50rpx; z-index: 10; display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background: #185c3a; box-shadow: 0 12rpx 28rpx rgba(24,92,58,.28); color: #fff; font-size: 54rpx; font-weight: 300; }.modal-mask { position: fixed; inset: 0; z-index: 100; background: rgba(17,36,26,.5); }.modal-content { position: fixed; top: 50%; right: 28rpx; left: 28rpx; z-index: 101; display: flex; max-height: 82vh; transform: translateY(-50%); border-radius: 26rpx; background: #fff; flex-direction: column; }.modal-header { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #edf0ec; }.modal-title { color: #294035; font-size: 32rpx; font-weight: 800; }.modal-close { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; color: #8d988f; font-size: 32rpx; }.modal-body { max-height: 59vh; padding: 30rpx; box-sizing: border-box; }.form-item { margin-bottom: 24rpx; }.form-item.half { flex: 1; }.form-label { display: block; margin-bottom: 12rpx; color: #5d6e64; font-size: 23rpx; }.form-row { display: flex; gap: 18rpx; }.form-input { width: 100%; min-height: 78rpx; padding: 0 20rpx; border: 1rpx solid #e3e9e1; border-radius: 15rpx; background: #fafcf9; color: #34473a; font-size: 26rpx; line-height: 78rpx; box-sizing: border-box; }.image-upload { position: relative; display: flex; align-items: center; justify-content: center; width: 152rpx; height: 152rpx; overflow: hidden; border-radius: 18rpx; background: #edf4ec; }.upload-img { width: 100%; height: 100%; }.upload-placeholder { display: flex; align-items: center; flex-direction: column; color: #68806f; }.plus-icon { font-size: 44rpx; }.upload-tip { margin-top: 5rpx; font-size: 20rpx; }.unit-selector { display: flex; flex-wrap: wrap; gap: 12rpx; }.unit-option { min-width: 64rpx; padding: 14rpx 19rpx; border-radius: 12rpx; background: #f1f5ef; color: #637269; font-size: 23rpx; text-align: center; }.unit-option.active { background: #185c3a; color: #fff; }.modal-footer { display: flex; gap: 14rpx; padding: 22rpx 30rpx; border-top: 1rpx solid #edf0ec; }.btn-cancel, .btn-save { display: flex; align-items: center; justify-content: center; height: 80rpx; border-radius: 17rpx; font-size: 26rpx; flex: 1; }.btn-cancel { background: #f1f4f0; color: #68776e; }.btn-save { background: #185c3a; color: #fff; font-weight: 700; }
