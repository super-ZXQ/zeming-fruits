<view class="container">
  <view class="header">
    <view><text class="title">购物车</text><text class="header-tip">选好水果后提交预订</text></view>
    <text class="count" wx:if="{{cart.length > 0}}">共{{cart.length}}件</text>
  </view>

  <view class="content" wx:if="{{cart.length > 0}}">
    <scroll-view scroll-y class="cart-list">
      <view class="cart-item {{item.unavailable ? 'unavailable' : ''}}" wx:for="{{cart}}" wx:key="id">
        <view class="checkbox {{item.selected ? 'checked' : ''}}" bindtap="toggleSelect" data-id="{{item.id}}">
          <text wx:if="{{item.selected}}">✓</text>
        </view>
        
        <view class="item-img">
          <image wx:if="{{item.imageUrl}}" class="product-image" src="{{item.imageUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>
          <text wx:else class="image-placeholder">暂无图片</text>
        </view>
        
        <view class="item-info">
          <text class="name">{{item.name}}</text>
          <text class="item-alert" wx:if="{{item.unavailable}}">已下架，请删除</text>
          <text class="item-alert price-changed" wx:elif="{{item.priceChanged}}">价格已更新</text>
          <view class="bottom">
            <text class="price">¥{{item.price}}</text>
            <view class="quantity">
              <text class="btn" bindtap="decreaseCount" data-id="{{item.id}}">-</text>
              <text class="num">{{item.count}}</text>
              <text class="btn" bindtap="increaseCount" data-id="{{item.id}}">+</text>
            </view>
          </view>
        </view>
        
        <view class="delete" bindtap="deleteItem" data-id="{{item.id}}">×</view>
      </view>
    </scroll-view>
  </view>

  <view class="empty" wx:else>
    <text class="empty-icon">🛒</text>
    <text class="empty-text">购物车里还没有鲜果</text>
    <view class="go-btn" bindtap="goShopping">去挑选</view>
  </view>

  <view class="footer" wx:if="{{cart.length > 0}}">
    <view class="delivery-rule">到店自取 / 3km 内配送 ¥5</view>
    <view class="select-all" bindtap="toggleSelectAll">
      <view class="checkbox {{allSelected ? 'checked' : ''}}">
        <text wx:if="{{allSelected}}">✓</text>
      </view>
      <text>全选</text>
    </view>
    
    <view class="right">
      <view class="total">
        <text>预估金额</text>
        <text class="price">¥{{totalPrice}}</text>
      </view>
      <view class="checkout-btn {{selectedCount > 0 ? '' : 'disabled'}}" bindtap="goToCheckout">
        去预约({{selectedCount}})
      </view>
    </view>
  </view>
</view>
