<view class="container">
  <view class="category-header"><text class="category-title">挑选鲜果</text><text class="category-tip">每日新鲜备货</text></view>
  <view class="main-content">
    <view class="left-menu"><scroll-view scroll-y class="menu-scroll"><view class="menu-item {{currentCategory === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" bindtap="switchCategory" data-id="{{item.id}}"><text>{{item.name}}</text></view></scroll-view></view>
    <view class="right-content"><scroll-view scroll-y class="product-scroll"><view class="category-caption"><text>{{currentCategoryName}}</text><text>新鲜备货 · 预约到店</text></view><view class="product-list" wx:if="{{products.length > 0}}"><view class="product-card" wx:for="{{products}}" wx:key="id"><view class="product-image"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" class="product-img" binderror="onImageError" data-index="{{index}}"></image><text wx:else class="image-placeholder">暂无图片</text></view><view class="product-info"><text class="product-name">{{item.name}}</text><text class="product-meta">{{item.unit}} · 月售 {{item.sales}}</text><view class="price-row"><view><text class="current-price">¥{{item.price}}</text><text class="original-price" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text></view><view class="add-btn" bindtap="addToCart" data-item="{{item}}"><text>＋</text></view></view></view></view></view><view class="loading-more" wx:if="{{loading}}">正在更新鲜果…</view><view class="empty-products" wx:if="{{loadError}}"><text>{{loadError}}</text><view class="retry-btn" bindtap="retryLoad">重新加载</view></view><view class="empty-products" wx:if="{{products.length === 0 && !loading && !loadError}}"><text>该分类暂未上架商品</text><text>可切换其他分类看看</text></view></scroll-view></view>
  </view>
  <view class="bottom-bar"><view class="delivery-info"><view class="delivery-dot"></view><view><text>预订后由商家确认</text><text>配送范围 3km，费用 ¥5</text></view></view><view class="cart-preview" bindtap="goToCart"><text class="cart-count" wx:if="{{cartCount > 0}}">{{cartCount}}</text><text>购物车</text><text class="cart-price">¥{{cartTotal}}</text></view></view>
</view>
