.container { height: 100vh; padding-bottom: 116rpx; background: #f6f7f2; }.category-header { display: flex; align-items: baseline; justify-content: space-between; height: 116rpx; padding: 34rpx 28rpx 20rpx; background: #fff; }.category-title { color: #1e3428; font-size: 38rpx; font-weight: 800; }.category-tip { color: #8a978f; font-size: 21rpx; }.main-content { display: flex; height: calc(100vh - 232rpx); }.left-menu { width: 180rpx; background: #edf1eb; }.menu-scroll, .product-scroll { height: 100%; }.menu-item { display: flex; align-items: center; justify-content: center; min-height: 104rpx; padding: 0 12rpx; color: #748078; font-size: 24rpx; text-align: center; }.menu-item.active { position: relative; background: #f6f7f2; color: #185c3a; font-weight: 800; }.menu-item.active:before { position: absolute; left: 0; width: 6rpx; height: 38rpx; border-radius: 0 8rpx 8rpx 0; background: #185c3a; content: ''; }.right-content { flex: 1; min-width: 0; }.product-scroll { padding: 20rpx; }.category-caption { display: flex; margin: 4rpx 0 20rpx; flex-direction: column; }.category-caption text:first-child { color: #2a3d32; font-size: 31rpx; font-weight: 800; }.category-caption text:last-child { margin-top: 6rpx; color: #99a39d; font-size: 19rpx; }.product-list { display: flex; flex-direction: column; gap: 16rpx; }.product-card { display: flex; align-items: center; padding: 16rpx; border: 1rpx solid #e7ece5; border-radius: 20rpx; background: #fff; }.product-image { display: flex; flex-shrink: 0; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; overflow: hidden; border-radius: 16rpx; background: #eef3ed; }.product-img { width: 100%; height: 100%; }.product-emoji { font-size: 65rpx; }.product-info { display: flex; min-width: 0; padding: 0 0 0 17rpx; flex: 1; flex-direction: column; }.product-name { overflow: hidden; color: #2b3d33; font-size: 26rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }.product-meta { margin-top: 7rpx; color: #919c95; font-size: 19rpx; }.price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }.current-price { color: #d94a3d; font-size: 31rpx; font-weight: 800; }.original-price { margin-left: 7rpx; color: #aab2ad; font-size: 18rpx; text-decoration: line-through; }.add-btn { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; border-radius: 16rpx; background: #185c3a; color: #fff; font-size: 31rpx; }.loading-more, .empty-products { display: flex; align-items: center; padding: 90rpx 0; color: #8e9992; font-size: 22rpx; text-align: center; flex-direction: column; }.empty-products text:last-child { margin-top: 10rpx; color: #b0b8b3; font-size: 19rpx; }.bottom-bar { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; min-height: 116rpx; padding: 15rpx 24rpx; border-top: 1rpx solid #e5eae4; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(34,58,44,.06); }.delivery-info { display: flex; align-items: center; color: #55665d; font-size: 20rpx; }.delivery-info view:last-child { display: flex; flex-direction: column; }.delivery-info text:last-child { margin-top: 5rpx; color: #99a39d; font-size: 18rpx; }.delivery-dot { width: 28rpx; height: 28rpx; margin-right: 10rpx; border: 7rpx solid #e9b85e; border-radius: 50%; }.cart-preview { position: relative; display: flex; align-items: center; gap: 10rpx; padding: 20rpx 24rpx; border-radius: 30rpx; background: #185c3a; color: #fff; font-size: 22rpx; }.cart-price { font-size: 27rpx; font-weight: 800; }.cart-count { position: absolute; top: -8rpx; left: -7rpx; display: flex; align-items: center; justify-content: center; min-width: 28rpx; height: 28rpx; border-radius: 14rpx; background: #d94a3d; color: #fff; font-size: 17rpx; }.add-btn:active, .cart-preview:active, .menu-item:active { opacity: .75; }
.retry-btn { margin-top: 24rpx; padding: 14rpx 28rpx; border: 1rpx solid #185c3a; border-radius: 28rpx; color: #185c3a; font-size: 21rpx; }
