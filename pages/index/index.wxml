<view class="container">
  <view class="hero">
    <view class="hero-top">
      <view class="brand">
        <view class="brand-mark"><view class="leaf leaf-one"></view><view class="leaf leaf-two"></view></view>
        <view><text class="brand-name">泽明果业</text><text class="brand-subtitle">每日鲜果 · 线上预约</text></view>
      </view>
      <button class="share-btn" open-type="share"><view class="icon-share"></view></button>
    </view>
    <view class="service-card">
      <view class="service-icon"><view class="icon-truck"></view></view>
      <view class="service-copy"><text>新鲜备货，按需预约</text><text>3km 内配送费固定 ¥5</text></view>
      <text class="service-tag">到店自取</text>
    </view>
  </view>

  <view class="notice-bar"><view class="icon-bell"></view><swiper vertical autoplay circular interval="3500"><swiper-item wx:for="{{notices}}" wx:key="index"><text>{{item}}</text></swiper-item></swiper></view>

  <view class="content">
    <view class="section-head"><view><text class="eyebrow">PICKED FOR TODAY</text><text class="section-title">今日鲜果</text></view><view class="all-link" bindtap="goToAllProducts">全部商品 <text>›</text></view></view>

    <view class="category-row">
      <view class="category-item" wx:for="{{categories}}" wx:key="id" bindtap="goToCategory" data-id="{{item.id}}">
        <view class="category-icon {{item.icon}}"><view class="category-line"></view></view><text>{{item.name}}</text>
      </view>
    </view>

    <view class="product-grid" wx:if="{{products.length > 0}}">
      <view class="product-card" wx:for="{{products}}" wx:key="id">
        <view class="product-image"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image><text wx:else class="image-placeholder">暂无图片</text><view class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</view></view>
        <view class="product-info"><text class="product-name">{{item.name}}</text><text class="product-desc">{{item.description || '新鲜备货'}}</text><view class="product-bottom"><view><text class="product-price">¥{{item.price}}</text><text class="product-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text></view><view class="add-btn" bindtap="addToCart" data-item="{{item}}"><view class="icon-plus"></view></view></view></view>
      </view>
    </view>

    <view class="product-empty" wx:if="{{!loading && !loadError && products.length === 0}}"><text>鲜果正在上新</text><text>稍后再来看看吧</text></view>
    <view class="product-empty" wx:if="{{loadError}}"><text>{{loadError}}</text><view class="retry-btn" bindtap="retryLoad">重新加载</view></view>
    <view class="loading-state" wx:if="{{loading}}">正在挑选今日鲜果…</view>
  </view>
</view>
