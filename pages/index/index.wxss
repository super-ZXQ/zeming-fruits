.container { min-height: 100vh; background: #f6f7f2; }
.hero { padding: 36rpx 28rpx 30rpx; background: linear-gradient(145deg, #10482f 0%, #1c6a43 100%); }
.hero-top, .brand, .service-card, .product-bottom, .section-head, .category-row { display: flex; align-items: center; }
.hero-top { justify-content: space-between; }
.brand-mark { position: relative; width: 62rpx; height: 62rpx; margin-right: 16rpx; border-radius: 22rpx; background: #f5d685; }
.leaf { position: absolute; width: 20rpx; height: 32rpx; border-radius: 22rpx 2rpx 22rpx 2rpx; background: #185c3a; transform: rotate(-38deg); }
.leaf-one { top: 13rpx; left: 19rpx; }.leaf-two { top: 9rpx; left: 30rpx; transform: rotate(27deg); background: #d94a3d; }
.brand-name, .brand-subtitle, .service-copy text, .section-title, .eyebrow, .product-name, .product-desc { display: block; }
.brand-name { color: #fff; font-size: 34rpx; font-weight: 800; letter-spacing: 1rpx; }.brand-subtitle { margin-top: 4rpx; color: rgba(255,255,255,.65); font-size: 20rpx; }
.share-btn { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin:0; padding:0; border: 1rpx solid rgba(255,255,255,.2); border-radius: 50%; background: rgba(255,255,255,.11); line-height:normal; }
.icon-share { width: 22rpx; height: 22rpx; border: 3rpx solid #fff; border-radius: 50%; position: relative; }.icon-share:after { position: absolute; top: -9rpx; left: 8rpx; width: 3rpx; height: 15rpx; background: #fff; content: ''; transform: rotate(-38deg); }
.service-card { margin-top: 32rpx; padding: 22rpx; border: 1rpx solid rgba(255,255,255,.15); border-radius: 22rpx; background: rgba(255,255,255,.1); }
.service-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: 20rpx; background: #f5d685; }.icon-truck { width: 29rpx; height: 19rpx; border: 3rpx solid #185c3a; border-radius: 4rpx; position: relative; }.icon-truck:before, .icon-truck:after { position: absolute; bottom: -9rpx; width: 7rpx; height: 7rpx; border-radius: 50%; background: #185c3a; content: ''; }.icon-truck:before { left: 2rpx; }.icon-truck:after { right: 2rpx; }
.service-copy { flex: 1; }.service-copy text:first-child { color: #fff; font-size: 25rpx; font-weight: 700; }.service-copy text:last-child { margin-top: 4rpx; color: rgba(255,255,255,.7); font-size: 20rpx; }.service-tag { padding: 8rpx 13rpx; border-radius: 20rpx; background: rgba(255,255,255,.16); color: #fff; font-size: 19rpx; }
.notice-bar { display: flex; align-items: center; height: 70rpx; padding: 0 30rpx; background: #fffdf8; color: #6a756e; font-size: 22rpx; }.notice-bar swiper { height: 70rpx; flex: 1; line-height: 70rpx; }.icon-bell { width: 17rpx; height: 17rpx; margin-right: 16rpx; border: 3rpx solid #d94a3d; border-radius: 10rpx 10rpx 4rpx 4rpx; }
.content { padding: 34rpx 24rpx 52rpx; }.section-head { justify-content: space-between; }.eyebrow { color: #a18a53; font-size: 17rpx; font-weight: 700; letter-spacing: 2rpx; }.section-title { margin-top: 6rpx; color: #1f3429; font-size: 38rpx; font-weight: 800; }.all-link { color: #607167; font-size: 22rpx; }.all-link text { margin-left: 5rpx; color: #185c3a; font-size: 32rpx; vertical-align: -2rpx; }
.category-row { justify-content: space-between; margin: 30rpx 0 34rpx; }.category-item { display: flex; align-items: center; min-width: 112rpx; flex-direction: column; color: #506058; font-size: 20rpx; }.category-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-bottom: 10rpx; border-radius: 24rpx; background: #eaf2e8; }.category-icon.slice { background: #fff0dc; }.category-icon.nut { background: #f4ead4; }.category-icon.snack { background: #f8e8e6; }.category-line { width: 23rpx; height: 23rpx; border: 3rpx solid #185c3a; border-radius: 50%; }.slice .category-line { border-radius: 15rpx 4rpx 15rpx 4rpx; border-color: #d94a3d; }.nut .category-line { width: 17rpx; height: 25rpx; border-radius: 50%; border-color: #a97528; }.snack .category-line { border-color: #bf6456; border-radius: 7rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }.product-card { overflow: hidden; border: 1rpx solid #e8ece5; border-radius: 22rpx; background: #fff; }.product-image { position: relative; display: flex; align-items: center; justify-content: center; height: 212rpx; overflow: hidden; background: #eef3ed; font-size: 86rpx; }.product-image image { width: 100%; height: 100%; }.product-tag { position: absolute; top: 12rpx; left: 12rpx; max-width: 120rpx; overflow: hidden; padding: 6rpx 10rpx; border-radius: 8rpx; background: rgba(24,92,58,.88); color: #fff; font-size: 18rpx; text-overflow: ellipsis; white-space: nowrap; }.product-info { padding: 17rpx 16rpx 16rpx; }.product-name { overflow: hidden; color: #25382d; font-size: 26rpx; font-weight: 700; line-height: 1.35; text-overflow: ellipsis; white-space: nowrap; }.product-desc { margin-top: 7rpx; overflow: hidden; color: #89948d; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }.product-bottom { justify-content: space-between; margin-top: 16rpx; }.product-price { color: #d94a3d; font-size: 30rpx; font-weight: 800; }.product-original { margin-left: 6rpx; color: #aab2ad; font-size: 18rpx; text-decoration: line-through; }.add-btn { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; border-radius: 18rpx; background: #185c3a; }.icon-plus { position: relative; width: 20rpx; height: 20rpx; }.icon-plus:before, .icon-plus:after { position: absolute; top: 8rpx; left: 0; width: 20rpx; height: 3rpx; border-radius: 3rpx; background: #fff; content: ''; }.icon-plus:after { transform: rotate(90deg); }
.product-empty, .loading-state { display: flex; align-items: center; padding: 100rpx 0; flex-direction: column; color: #7d8a82; font-size: 24rpx; }.product-empty text:last-child { margin-top: 10rpx; color: #a1aaa4; font-size: 21rpx; }.empty-fruit { margin-bottom: 16rpx; font-size: 80rpx; }
.share-btn:active, .service-card:active, .category-item:active, .add-btn:active { opacity: .75; }
.retry-btn{margin-top:18rpx;padding:13rpx 24rpx;border-radius:14rpx;background:#185c3a;color:#fff;font-size:22rpx}
