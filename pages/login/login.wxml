<view class="container">
  <view class="login-header"><view class="logo-frame"><image class="store-logo" src="{{logoUrl}}" mode="aspectFit"></image></view><text class="app-name">泽明果业</text><text class="header-subtitle">把新鲜留给每一次预约</text></view>
  <view class="login-content"><view class="welcome"><text>欢迎来到泽明果业</text><text>登录后可管理预约、地址与配送进度</text></view><button class="phone-login-btn {{!agreed ? 'disabled' : ''}}" disabled="{{!agreed || loading}}" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber"><view class="button-phone-icon"></view>{{loading ? '登录中…' : '手机号快捷登录'}}</button><view class="skip-btn" bindtap="skipLogin">先随便逛逛</view></view>
  <view class="agreement" bindtap="toggleAgreement"><view class="agreement-check {{agreed ? 'checked' : ''}}"><text wx:if="{{agreed}}">✓</text></view><view class="agreement-copy"><text class="agreement-hint">我已阅读并同意</text><text class="link" catchtap="viewPrivacy">《用户隐私协议》</text><text class="link" catchtap="viewAgreement">《用户服务条款》</text></view></view>
</view>
