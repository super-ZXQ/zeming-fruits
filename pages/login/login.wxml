<view class="container">
  <view class="login-header"><view class="logo-frame"><image class="store-logo" src="{{logoUrl}}" mode="aspectFit"></image></view><text class="app-name">泽明果业</text><text class="header-subtitle">把新鲜留给每一次预约</text></view>
  <view class="login-content"><view class="welcome"><text>欢迎来到泽明果业</text><text>登录后可管理预约、地址与配送进度</text></view><button class="phone-login-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhoneNumber"><view class="button-phone-icon"></view>手机号快捷登录</button><view class="skip-btn" bindtap="skipLogin">先随便逛逛</view></view>
  <view class="agreement"><text class="agreement-hint">登录即代表同意</text><text class="link" bindtap="viewPrivacy">《用户隐私协议》</text><text class="link" bindtap="viewAgreement">《用户服务条款》</text></view>
</view>
<view class="privacy-modal" wx:if="{{showPrivacyModal}}" catchtouchmove="preventMove"><view class="privacy-mask" bindtap="closePrivacyModal"></view><view class="privacy-dialog"><view class="privacy-title">隐私授权提示</view><view class="privacy-content"><text class="privacy-text">为了完成预约与配送服务，我们需要以下信息：</text><view class="privacy-list"><text class="privacy-item">• 手机号码：用于账号登录和身份识别</text><text class="privacy-item">• 收货地址：用于水果配送服务</text><text class="privacy-item">• 定位信息：用于计算配送距离</text></view><text class="privacy-text">我们会妥善保护你的个人信息。</text><view class="privacy-policy-link"><text>详细内容请阅读</text><text class="link" bindtap="viewPrivacyInModal">《用户隐私协议》</text></view></view><view class="privacy-buttons"><button class="privacy-btn disagree" bindtap="disagreePrivacy">不同意</button><button class="privacy-btn agree" bindtap="agreePrivacy">同意并继续</button></view></view></view>
