.container { min-height: 100vh; padding: 76rpx 34rpx 60rpx; background: #f6f7f2; }.login-header { display: flex; align-items: center; flex-direction: column; }.logo-frame { display: flex; align-items: center; justify-content: center; width: 156rpx; height: 156rpx; border: 8rpx solid #e7f0e8; border-radius: 48rpx; background: #fff; box-shadow: 0 16rpx 30rpx rgba(27,72,47,.08); }.store-logo { width: 126rpx; height: 126rpx; border-radius: 36rpx; }.app-name { margin-top: 24rpx; color: #1d382b; font-size: 40rpx; font-weight: 800; }.header-subtitle { margin-top: 10rpx; color: #7d8d83; font-size: 22rpx; }.login-content { margin-top: 64rpx; padding: 42rpx 34rpx 32rpx; border: 1rpx solid #e7ece5; border-radius: 28rpx; background: #fff; }.welcome text { display: block; }.welcome text:first-child { color: #263d30; font-size: 31rpx; font-weight: 800; }.welcome text:last-child { margin-top: 12rpx; color: #8b978f; font-size: 22rpx; line-height: 1.5; }.phone-login-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 94rpx; margin-top: 40rpx; border-radius: 20rpx; background: #185c3a; color: #fff; font-size: 28rpx; font-weight: 700; }.button-phone-icon { width: 20rpx; height: 27rpx; margin-right: 12rpx; border: 3rpx solid #fff; border-radius: 5rpx; }.skip-btn { margin-top: 28rpx; color: #68776e; font-size: 24rpx; text-align: center; }.agreement { display: flex; align-items: center; justify-content: center; margin-top: 34rpx; color: #9aa49e; font-size: 20rpx; }.link { margin-left: 6rpx; color: #2d7650; }.privacy-modal { position: fixed; inset: 0; z-index: 99; display: flex; align-items: center; justify-content: center; }.privacy-mask { position: absolute; inset: 0; background: rgba(16,38,27,.55); }.privacy-dialog { position: relative; width: 620rpx; padding: 42rpx 34rpx 30rpx; border-radius: 28rpx; background: #fff; }.privacy-title { color: #263d30; font-size: 32rpx; font-weight: 800; text-align: center; }.privacy-content { margin-top: 28rpx; }.privacy-text, .privacy-item, .privacy-policy-link { color: #68776e; font-size: 23rpx; line-height: 1.7; }.privacy-text { display: block; }.privacy-list { margin: 18rpx 0; padding: 18rpx; border-radius: 16rpx; background: #f4f7f3; }.privacy-item { display: block; }.privacy-policy-link { margin-top: 14rpx; text-align: center; }.privacy-buttons { display: flex; gap: 16rpx; margin-top: 26rpx; }.privacy-btn { display: flex; align-items: center; justify-content: center; height: 82rpx; margin: 0; border-radius: 18rpx; font-size: 25rpx; flex: 1; }.privacy-btn.disagree { background: #f1f4f1; color: #77837c; }.privacy-btn.agree { background: #185c3a; color: #fff; }
