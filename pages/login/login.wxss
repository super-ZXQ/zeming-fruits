.container { min-height: 100vh; padding: 76rpx 34rpx 60rpx; background: #f6f7f2; }.login-header { display: flex; align-items: center; flex-direction: column; }.logo-frame { display: flex; align-items: center; justify-content: center; width: 156rpx; height: 156rpx; border: 8rpx solid #e7f0e8; border-radius: 48rpx; background: #fff; box-shadow: 0 16rpx 30rpx rgba(27,72,47,.08); }.store-logo { width: 126rpx; height: 126rpx; border-radius: 36rpx; }.app-name { margin-top: 24rpx; color: #1d382b; font-size: 40rpx; font-weight: 800; }.header-subtitle { margin-top: 10rpx; color: #7d8d83; font-size: 22rpx; }.login-content { margin-top: 64rpx; padding: 42rpx 34rpx 32rpx; border: 1rpx solid #e7ece5; border-radius: 28rpx; background: #fff; }.welcome text { display: block; }.welcome text:first-child { color: #263d30; font-size: 31rpx; font-weight: 800; }.welcome text:last-child { margin-top: 12rpx; color: #8b978f; font-size: 22rpx; line-height: 1.5; }.phone-login-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 94rpx; margin-top: 40rpx; border-radius: 20rpx; background: #185c3a; color: #fff; font-size: 28rpx; font-weight: 700; }.phone-login-btn.disabled { background: #b8c5ba; color: rgba(255,255,255,.88); }.button-phone-icon { width: 20rpx; height: 27rpx; margin-right: 12rpx; border: 3rpx solid currentColor; border-radius: 5rpx; }.skip-btn { margin-top: 28rpx; color: #68776e; font-size: 24rpx; text-align: center; }.agreement { display: flex; align-items: flex-start; margin: 34rpx 14rpx 0; color: #9aa49e; font-size: 20rpx; }.agreement-check { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; margin: 1rpx 10rpx 0 0; border: 2rpx solid #a7b3aa; border-radius: 50%; color: #fff; font-size: 18rpx; flex: 0 0 auto; }.agreement-check.checked { border-color: #185c3a; background: #185c3a; }.agreement-copy { line-height: 1.5; }.link { margin-left: 6rpx; color: #2d7650; }
