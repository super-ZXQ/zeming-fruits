<view class="container">
  <view class="header">
    <view class="user-info" bindtap="handleUserInfo">
      <view class="avatar">
        <text wx:if="{{isLoggedIn && userInfo}}">{{userInfo.nickname[0] || '我'}}</text>
        <view class="avatar-placeholder" wx:else></view>
      </view>
      <view class="user-detail" wx:if="{{isLoggedIn}}">
        <text class="nickname">{{userInfo.nickname || '用户'}}</text>
      </view>
      <view class="login-tip" wx:else>
        <text class="login-text">点击登录</text>
        <text class="sub-text">管理预约、地址和配送进度</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
  </view>

  <view class="order-section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <view class="view-all" bindtap="goToOrders">
        <text>查看全部</text>
        <text class="arrow">›</text>
      </view>
    </view>
    
    <view class="order-tabs">
      <view class="order-tab" bindtap="goToOrders" data-status="pending">
        <view class="tab-icon pending-icon"></view>
        <text>待确认</text>
      </view>
      <view class="order-tab" bindtap="goToOrders" data-status="active">
        <view class="tab-icon confirmed-icon"></view>
        <text>进行中</text>
      </view>
      <view class="order-tab" bindtap="goToOrders" data-status="completed">
        <view class="tab-icon completed-icon"></view>
        <text>已完成</text>
      </view>
      <view class="order-tab" bindtap="goToOrders" data-status="after_sale">
        <view class="tab-icon service-icon"></view>
        <text>售后</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-item" bindtap="goToAddress">
      <view class="menu-icon address-icon"></view>
      <text class="menu-label">收货地址</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="contactService">
      <view class="menu-icon phone-icon"></view>
      <text class="menu-label">联系客服</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item admin-entry" bindtap="goToAdmin" wx:if="{{isAdmin}}">
      <view class="menu-icon admin-icon"></view>
      <text class="menu-label">商品管理</text>
      <text class="admin-badge">管理员</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
