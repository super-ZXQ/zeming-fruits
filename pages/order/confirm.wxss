.container{min-height:100vh;background:#f6f7f2}.delivery-tabs{display:flex;gap:12rpx;padding:20rpx 24rpx;background:#fff}.tab{display:flex;align-items:center;justify-content:center;height:78rpx;border:1rpx solid #dfe7df;border-radius:18rpx;color:#64736a;font-size:26rpx;flex:1}.tab.active{border-color:#185c3a;background:#185c3a;color:#fff;font-weight:700}.content{height:calc(100vh - 120rpx);padding:18rpx 24rpx 150rpx;box-sizing:border-box}.service-note{display:flex;justify-content:space-between;margin-bottom:16rpx;padding:18rpx 20rpx;border-radius:18rpx;background:#eaf3eb;color:#376249;font-size:20rpx}.section{margin-bottom:16rpx;padding:24rpx;border:1rpx solid #e3e9e1;border-radius:24rpx;background:#fff}.section-head,.fee-row,.address-card{display:flex;align-items:center;justify-content:space-between}.section-title{display:block;margin-bottom:18rpx;color:#293f32;font-size:28rpx;font-weight:800}.section-head .section-title{margin-bottom:0}.rule{padding:7rpx 11rpx;border-radius:12rpx;background:#edf5ed;color:#2c7148;font-size:19rpx}.store-name{display:block;color:#304638;font-size:27rpx;font-weight:700}.store-line{display:block;margin-top:9rpx;color:#738078;font-size:21rpx;line-height:1.5}.map-link{margin-top:16rpx;color:#1e6a42;font-size:22rpx}.address-card{min-height:72rpx;margin-top:20rpx}.address-content{min-width:0;flex:1}.contact,.address-detail{display:block}.contact{color:#32473a;font-size:25rpx;font-weight:700}.address-detail{margin-top:9rpx;color:#69776e;font-size:21rpx;line-height:1.45}.address-empty{color:#7d8981;font-size:23rpx}.arrow{color:#a0aaa3;font-size:34rpx}.range-tip{display:block;margin-top:13rpx;color:#287249;font-size:20rpx}.time-options{display:flex;gap:12rpx}.time-option{display:flex;min-width:0;padding:17rpx;border:1rpx solid #e0e7df;border-radius:16rpx;flex:1;flex-direction:column}.time-option.active{border-color:#77a98a;background:#eff6f0}.time-option text:first-child{color:#354a3c;font-size:23rpx;font-weight:700}.time-option text:last-child{margin-top:6rpx;overflow:hidden;color:#8b978f;font-size:18rpx;text-overflow:ellipsis;white-space:nowrap}.schedule{margin-top:15rpx}.schedule picker view{display:flex;justify-content:space-between;padding:17rpx 0;border-top:1rpx solid #edf0ec;color:#6d7b72;font-size:22rpx}.schedule picker text{color:#354a3d}.muted{color:#929d95;font-size:20rpx}.goods-item{display:flex;align-items:center;padding:16rpx 0;border-top:1rpx solid #edf0ec}.goods-image{display:flex;align-items:center;justify-content:center;width:82rpx;height:82rpx;overflow:hidden;border-radius:16rpx;background:#eef3ed;font-size:38rpx}.goods-image image{width:100%;height:100%}.goods-info{min-width:0;margin-left:14rpx;flex:1}.goods-name,.goods-price{display:block}.goods-name{overflow:hidden;color:#32473a;font-size:24rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.goods-price{margin-top:7rpx;color:#d94a3d;font-size:22rpx}.quantity{color:#78857d;font-size:21rpx}.quote-error{display:flex;justify-content:space-between;padding:18rpx 0 0;color:#bd554c;font-size:21rpx}.quote-error view{color:#185c3a}.quoting{padding-top:18rpx;color:#809087;font-size:21rpx;text-align:center}.fee-row{padding:9rpx 0;color:#65746b;font-size:22rpx}.remark{width:100%;min-height:110rpx;padding:16rpx;border-radius:15rpx;background:#f4f7f3;color:#405247;font-size:22rpx;box-sizing:border-box}.agreement{display:flex;align-items:center;justify-content:center;color:#77837b;font-size:19rpx}.check{display:flex;align-items:center;justify-content:center;width:25rpx;height:25rpx;margin-right:8rpx;border:2rpx solid #aeb9b1;border-radius:50%;color:#fff;font-size:16rpx}.check.checked{border-color:#185c3a;background:#185c3a}.link{margin-left:4rpx;color:#256d48}.bottom-space{height:80rpx}.footer{position:fixed;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:space-between;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e2e8e0;background:#fff;box-shadow:0 -8rpx 24rpx rgba(30,61,43