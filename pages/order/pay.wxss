.container { min-height: 100vh; background: #f6f7f2; }.delivery-tabs { display: flex; gap: 12rpx; padding: 22rpx 24rpx 12rpx; background: #fff; }.tab { display: flex; align-items: center; justify-content: center; height: 76rpx; border: 1rpx solid #e4eae3; border-radius: 18rpx; color: #718078; font-size: 25rpx; flex: 1; }.tab.active { border-color: #185c3a; background: #185c3a; color: #fff; font-weight: 700; }.content { height: calc(100vh - 238rpx); padding: 18rpx 24rpx 168rpx; }.section { margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #e7ece5; border-radius: 24rpx; background: #fff; }.section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }.section-title { color: #2a4033; font-size: 28rpx; font-weight: 800; }.goods-count { color: #95a098; font-size: 20rpx; }.delivery-rule { margin-bottom: 18rpx; padding: 16rpx; border-radius: 14rpx; background: #eef6ee; color: #3d7451; font-size: 21rpx; }.pickup-info { color: #627168; }.pickup-name { color: #263d30; font-size: 30rpx; font-weight: 800; }.pickup-address, .pickup-time, .pickup-phone { display: block; margin-top: 10rpx; font-size: 22rpx; line-height: 1.45; }.pickup-map { display: inline-flex; align-items: center; margin-top: 18rpx; padding: 12rpx 15rpx; border-radius: 14rpx; background: #eff5ef; color: #185c3a; font-size: 21rpx; }.map-icon { margin-right: 7rpx; }.address-card { display: flex; align-items: center; }.address-content { min-width: 0; flex: 1; }.address-header { display: flex; align-items: center; }.contact-name { color: #2b4033; font-size: 28rpx; font-weight: 800; }.contact-phone { margin-left: 14rpx; color: #77847c; font-size: 22rpx; }.address-detail { margin-top: 10rpx; color: #647168; font-size: 22rpx; line-height: 1.45; }.address-distance { margin-top: 12rpx; }.distance-badge { padding: 6rpx 10rpx; border-radius: 8rpx; background: #e9f2ea; color: #257046; font-size: 19rpx; }.distance-badge.error { background: #fff0ee; color: #c6574c; }.address-empty { display: flex; align-items: center; flex: 1; color: #7d8a82; }.empty-icon { margin-right: 12rpx; font-size: 32rpx; }.arrow { margin-left: auto; color: #a4ada7; font-size: 32rpx; }.time-options { display: flex; gap: 12rpx; }.time-option { display: flex; min-width: 0; padding: 16rpx; border: 1rpx solid #e4eae3; border-radius: 16rpx; flex: 1; }.time-option.active { border-color: #9fc8aa; background: #f1f7f1; }.time-radio { width: 16rpx; height: 16rpx; margin: 7rpx 8rpx 0 0; border: 3rpx solid #b3beb6; border-radius: 50%; flex-shrink: 0; }.active .time-radio { border-color: #185c3a; box-shadow: inset 0 0 0 3rpx #f1f7f1; background: #185c3a; }.time-content text { display: block; }.time-title { color: #35483d; font-size: 22rpx; font-weight: 700; }.time-desc { margin-top: 5rpx; color: #96a097; font-size: 18rpx; }.schedule-picker { margin-top: 16rpx; border-top: 1rpx solid #edf0ec; }.picker-row { display: flex; align-items: center; justify-content: space-between; padding: 18rpx 0; border-bottom: 1rpx solid #edf0ec; color: #66756c; font-size: 22rpx; }.picker-value { display: flex; align-items: center; color: #2f4437; }.goods-item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #edf0ec; }.goods-item:last-child { border-bottom: none; }.goods-image { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; overflow: hidden; border-radius: 15rpx; background: #eef3ed; font-size: 40rpx; }.product-img { width: 100%; height: 100%; }.goods-info { min-width: 0; margin-left: 14rpx; flex: 1; }.goods-name { display: block; overflow: hidden; color: #32463a; font-size: 23rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.price-row { margin-top: 9rpx; }.goods-price { color: #d94a3d; font-size: 24rpx; font-weight: 800; }.goods-original-price { margin-left: 6rpx; color: #a3ada6; font-size: 18rpx; text-decoration: line-through; }.goods-quantity { color: #7b887f; font-size: 21rpx; }.goods-total { margin-left: 13rpx; color: #35483d; font-size: 22rpx; }.fee-item { display: flex; justify-content: space-between; padding: 10rpx 0; color: #718078; font-size: 22rpx; }.fee-item.discount { color: #c35b50; }.fee-error { color: #c6574c; }.remark-input { width: 100%; min-height: 110rpx; padding: 16rpx; border-radius: 15rpx; background: #f5f7f4; color: #415247; font-size: 22rpx; }.remark-option { display: flex; align-items: center; margin-top: 15rpx; color: #6d7a71; font-size: 20rpx; }.check-box { width: 22rpx; height: 22rpx; margin-right: 8rpx; border: 2rpx solid #bdc7bf; border-radius: 50%; }.remark-option.active .check-box, .agreement-row .check-box.checked { border-color: #185c3a; background: #185c3a; }.coupon-selector { display: flex; align-items: center; color: #617067; font-size: 22rpx; }.bottom-placeholder { height: 30rpx; }.footer { position: fixed; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: space-between; min-height: 124rpx; padding: 14rpx 24rpx; border-top: 1rpx solid #e3e9e1; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(30,61,43,.07); }.price-label { color: #7b887f; font-size: 19rpx; }.price-value { display: block; margin-top: 3rpx; color: #d94a3d; font-size: 34rpx; font-weight: 800; }.discount-tip { display: block; margin-top: 3rpx; color: #c6753a; font-size: 17rpx; }.pay-btn { display: flex; align-items: center; justify-content: center; min-width: 202rpx; height: 86rpx; border-radius: 20rpx; background: #185c3a; color: #fff; font-size: 27rpx; font-weight: 700; }.pay-btn.disabled { background: #c9d1cb; }.agreement-section { position: fixed; bottom: 126rpx; left: 0; right: 0; padding: 10rpx 24rpx; background: rgba(246,247,242,.96); }.agreement-row { display: flex; align-items: center; justify-content: center; color: #768279; font-size: 18rpx; }.agreement-row .check-box { width: 20rpx; height: 20rpx; }.agreement-link { margin-left: 4rpx; color: #2b7650; }.privacy-modal-pay, .coupon-modal { position: fixed; inset: 0; z-index: 99; display: flex; align-items: flex-end; justify-content: center; }.privacy-mask { position: absolute; inset: 0; background: rgba(14,37,25,.55); }.privacy-dialog, .coupon-modal-content { position: relative; width: 100%; max-height: 76vh; padding: 32rpx 28rpx; border-radius: 28rpx 28rpx 0 0; background: #fff; }.privacy-title, .modal-title { color: #263d30; font-size: 30rpx; font-weight: 800; text-align: center; }.privacy-content { margin-top: 24rpx; }.privacy-text, .privacy-item { display: block; color: #68776e; font-size: 22rpx; line-height: 1.65; }.privacy-list { margin: 16rpx 0; padding: 15rpx; border-radius: 15rpx; background: #f3f6f2; }.privacy-buttons { display: flex; gap: 14rpx; margin-top: 26rpx; }.privacy-btn { height: 82rpx; margin: 0; border-radius: 18rpx; font-size: 24rpx; flex: 1; }.privacy-btn.disagree { background: #eef2ee; color: #748178; }.privacy-btn.agree { background: #185c3a; color: #fff; }.modal-header { display: flex; align-items: center; justify-content: space-between; }.modal-close { color: #849087; font-size: 35rpx; }.coupon-list { max-height: 55vh; margin-top: 20rpx; }.coupon-item { display: flex; align-items: center; margin-bottom: 12rpx; padding: 17rpx; border: 1rpx solid #e5ebe3; border-radius: 16rpx; }.coupon-item.selected { border-color: #7eb08e; background: #f2f8f3; }.coupon-left { display: flex; min-width: 124rpx; align-items: center; flex-direction: column; }.coupon-value { color: #d94a3d; font-size: 31rpx; font-weight: 800; }.coupon-threshold, .coupon-type { color: #97a198; font-size: 18rpx; }.coupon-right { display: flex; flex-direction: column; }.coupon-name { color: #35493c; font-size: 24rpx; font-weight: 700; }.no-coupon { padding: 20rpx; color: #6b786f; text-align: center; font-size: 23rpx; }
