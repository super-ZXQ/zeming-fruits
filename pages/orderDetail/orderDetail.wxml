<view class="container"><view class="detail-header"><text class="status-text">{{statusText[order.status]}}</text><text class="status-desc">{{statusDesc[order.status]}}</text></view><view class="address-card" wx:if="{{order.contact}}"><text class="address-icon">{{order.deliveryType === 'pickup' ? '🏪' : '📍'}}</text><view class="address-info"><view class="name-phone"><text class="name">{{order.contact.name}}</text><text class="phone">{{order.contact.phone}}</text></view><text class="address-detail" wx:if="{{order.address}}">{{order.address.detail}}</text><text class="address-detail" wx:else>到店自取 · 泽明果业</text></view></view><view class="logistics-card"><view class="logistics-header"><text class="logistics-title">预约进度</text></view><view class="logistics-content"><view class="logistics-item" wx:for="{{timeline}}" wx:key="index"><view class="logistics-dot {{index === 0 ? 'active' : ''}}"></view><view class="logistics-text"><text class="logistics-desc">{{item.desc}}</text><text class="logistics-time">{{item.time}}</text></view></view></view></view><view class="order-info"><view class="info-title">预约信息</view><view class="info-item"><text class="label">预约编号</text><text class="value">{{order.orderNo || order.id}}</text></view><view class="info-item"><text class="label">提交时间</text><text class="value">{{order.createTimeText}}</text></view><view class="info-item"><text class="label">预约方式</text><text class="value">{{order.deliveryType === 'delivery' ? '送货上门' : '到店自取'}}</text></view><view class="info-item"><text class="label">希望时间</text><text class="value">{{order.scheduleText}}</text></view><view class="info-item" wx:if="{{order.remark}}"><text class="label">备注</text><text class="value">{{order.remark}}</text></view><view class="cancel-reason" wx:if="{{order.cancelReason}}">取消原因：{{order.cancelReason}}</view></view><view class="items-card"><view class="items-title">商品清单</view><view class="item" wx:for="{{order.items}}" wx:key="id"><view class="item-emoji"><image wx:if="{{item.imageUrl}}" src="{{item.imageUrl}}" mode="aspectFill"></image><text wx:else>{{item.emoji || '🍎'}}</text></view><view class="item-info"><text class="item-name">{{item.name}}</text><view class="item-bottom"><text class="price">¥{{item.price}}</text><text class="quantity">×{{item.count}}</text></view></view></view></view><view class="summary-card"><view class="summary-item"><text>商品金额</text><text>¥{{order.totalAmount}}</text></view><view class="summary-item" wx:if="{{order.deliveryFee}}"><text>配送费</text><text>¥{{order.deliveryFee}}</text></view><view class="summary-item total"><text>预估金额</text><text class="price">¥{{order.finalAmount}}</text></view><text class="estimate-note">本页面只展示预估金额，不进行在线支付</text></view><view class="detail-footer"><view class="action-btn secondary" bindtap="contactService">联系商家</view><view class="action-btn danger" wx:if="{{order.status === 'pending'}}" bindtap="cancelOrder">取消预约</view><view class="action-btn" wx:if="{{order.status === 'ready' || order.status === 'delivering'}}" bindtap="confirmReceive">{{order.status === 'ready' ? '确认取货' : '确认收货'}}</view><view class="action-btn" wx:if="{{order.status === 'completed' && !order.afterSaleResolvedAt}}" bindtap="applyAfterSale">申请售后</view></view></view>
