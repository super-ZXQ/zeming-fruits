.container { min-height: 100vh; padding: 24rpx 24rpx 150rpx; background: #f6f7f2; }.detail-header { padding: 34rpx 28rpx; border-radius: 26rpx; background: linear-gradient(145deg, #185c3a, #2b7a51); }.status-text, .status-desc { display: block; }.status-text { color: #fff; font-size: 35rpx; font-weight: 800; }.status-desc { margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 22rpx; line-height: 1.45; }.address-card, .logistics-card, .order-info, .items-card, .summary-card { margin-top: 16rpx; padding: 24rpx; border: 1rpx solid #e5ebe3; border-radius: 24rpx; background: #fff; }.address-card { display: flex; align-items: center; }.address-icon { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 16rpx; border-radius: 19rpx; background: #eaf3eb; font-size: 30rpx; }.address-info { min-width: 0; flex: 1; }.name-phone { display: flex; align-items: center; }.name { color: #34483c; font-size: 26rpx; font-weight: 800; }.phone { margin-left: 13rpx; color: #7a877e; font-size: 22rpx; }.address-detail { display: block; margin-top: 9rpx; color: #647168; font-size: 21rpx; line-height: 1.45; }.logistics-header, .items-title, .info-title { color: #2e4437; font-size: 27rpx; font-weight: 800; }.logistics-icon { margin-right: 9rpx; }.logistics-content { margin-top: 23rpx; }.logistics-item { position: relative; display: flex; min-height: 70rpx; }.logistics-item:not(:last-child):after { position: absolute; top: 27rpx; left: 9rpx; width: 2rpx; height: calc(100% - 8rpx); background: #d9e3dc; content: ''; }.logistics-dot { z-index: 1; width: 20rpx; height: 20rpx; margin: 4rpx 16rpx 0 0; border: 5rpx solid #c8d5cc; border-radius: 50%; background: #fff; }.logistics-dot.active { border-color: #185c3a; }.logistics-text { display: flex; flex: 1; flex-direction: column; }.logistics-desc { color: #526258; font-size: 22rpx; }.logistics-time { margin-top: 7rpx; color: #9aa49e; font-size: 18rpx; }.info-title, .items-title { margin-bottom: 16rpx; }.info-item, .summary-item { display: flex; justify-content: space-between; padding: 12rpx 0; color: #7b877f; font-size: 21rpx; }.info-item .value { max-width: 430rpx; overflow: hidden; color: #425448; text-align: right; text-overflow: ellipsis; white-space: nowrap; }.item { display: flex; align-items: center; padding: 16rpx 0; border-top: 1rpx solid #edf0ec; }.item-emoji { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; margin-right: 14rpx; border-radius: 16rpx; background: #eef3ed; font-size: 36rpx; }.item-info { min-width: 0; flex: 1; }.item-name { display: block; overflow: hidden; color: #35493c; font-size: 24rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.item-desc { margin-top: 6rpx; color: #98a198; font-size: 18rpx; }.item-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }.item-bottom .price { color: #d94a3d; font-size: 24rpx; font-weight: 800; }.quantity { color: #849087; font-size: 20rpx; }.summary-card { padding-top: 14rpx; padding-bottom: 14rpx; }.summary-item.total { margin-top: 7rpx; padding-top: 17rpx; border-top: 1rpx solid #edf0ec; color: #3e5045; font-weight: 700; }.summary-item.total .price { color: #d94a3d; font-size: 30rpx; }.detail-footer { position: fixed; right: 0; bottom: 0; left: 0; display: flex; gap: 14rpx; padding: 16rpx 24rpx; border-top: 1rpx solid #e4e9e3; background: #fff; box-shadow: 0 -8rpx 24rpx rgba(30,61,43,.06); }.action-btn { display: flex; align-items: center; justify-content: center; height: 84rpx; border-radius: 19rpx; background: #185c3a; color: #fff; font-size: 25rpx; font-weight: 700; flex: 1; }
