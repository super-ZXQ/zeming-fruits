<view class="container">
  <scroll-view scroll-x class="tabs"><view class="tab-row"><view class="tab {{currentStatus === 'all' ? 'active' : ''}}" bindtap="switchTab" data-status="all">全部</view><view class="tab {{currentStatus === 'pending' ? 'active' : ''}}" bindtap="switchTab" data-status="pending">待确认<view class="tab-badge" wx:if="{{pendingCount}}">{{pendingCount}}</view></view><view class="tab {{currentStatus === 'active' ? 'active' : ''}}" bindtap="switchTab" data-status="active">进行中</view><view class="tab {{currentStatus === 'completed' ? 'active' : ''}}" bindtap="switchTab" data-status="completed">已完成</view><view class="tab {{currentStatus === 'after_sale' ? 'active' : ''}}" bindtap="switchTab" data-status="after_sale">售后</view></view></scroll-view>
  <scroll-view scroll-y class="list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}"><view class="order-header"><view class="header-left"><text class="order-id">{{item.orderNo || item.id}}</text><text class="order-time">{{item.createTimeText}} · {{item.modeText}}</text></view><text class="order-status {{item.status}}">{{statusText[item.status]}}</text></view><view class="order-items"><view class="item" wx:for="{{item.items}}" wx:for-item="goods" wx:key="id" wx:if="{{index < 3}}"><view class="item-emoji"><image wx:if="{{goods.imageUrl}}" src="{{goods.imageUrl}}" mode="aspectFill"></image><text wx:else>{{goods.emoji || '🍎'}}</text></view><view class="item-info"><text class="name">{{goods.name}}</text><text class="price">¥{{goods.price}} × {{goods.count}}</text></view></view><view class="more-items" wx:if="{{item.items.length > 3}}">另有 {{item.items.length - 3}} 件商品</view></view><view class="order-footer"><text class="total">预估 <text class="price">¥{{item.totalAmount}}</text></text><view class="action-btn">查看详情</view></view></view>
    <view class="empty" wx:if="{{loadError}}"><text class="empty-icon">!</text><text class="empty-text">{{loadError}}</text><view class="go-shopping" bindtap="loadOrders">重新加载</view></view>
    <view class="empty" wx:elif="{{!loading && orders.length === 0}}"><text class="empty-icon">📋</text><text class="empty-text">暂无相关预约</text><text class="empty-tip">挑选喜欢的水果，提交后由商家确认</text><view class="go-shopping" bindtap="goShopping">去挑选</view></view>
    <view class="empty" wx:if="{{loading}}"><text class="empty-text">正在加载预约…</text></view>
  </scroll-view>
</view>
