.container { min-height: 100vh; background: #f6f7f2; }.tabs { display: flex; padding: 20rpx 20rpx 14rpx; gap: 10rpx; background: #fff; }.tab { position: relative; display: flex; align-items: center; justify-content: center; height: 64rpx; border-radius: 16rpx; color: #78857d; font-size: 22rpx; flex: 1; }.tab.active { background: #eaf3eb; color: #185c3a; font-weight: 800; }.tab-badge { position: absolute; top: -5rpx; right: 8rpx; min-width: 24rpx; height: 24rpx; border-radius: 12rpx; background: #d94a3d; color: #fff; font-size: 16rpx; line-height: 24rpx; text-align: center; }.list { height: calc(100vh - 98rpx); padding: 20rpx 24rpx; box-sizing: border-box; }.order-card { margin-bottom: 16rpx; padding: 22rpx; border: 1rpx solid #e5ebe3; border-radius: 24rpx; background: #fff; }.order-header, .order-footer, .header-left, .actions { display: flex; align-items: center; }.order-header, .order-footer { justify-content: space-between; }.header-left { min-width: 0; flex-direction: column; align-items: flex-start; }.order-id { overflow: hidden; max-width: 410rpx; color: #34483c; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }.order-time { margin-top: 7rpx; color: #9aa39d; font-size: 18rpx; }.order-status { padding: 7rpx 11rpx; border-radius: 9rpx; background: #edf3ed; color: #48805a; font-size: 18rpx; }.order-status.pending { background: #fff4e4; color: #b37327; }.order-status.completed { background: #f0f1ef; color: #7c8780; }.order-status.refund { background: #fff0ee; color: #c45e53; }.order-items { margin-top: 18rpx; padding: 3rpx 0; border-top: 1rpx solid #edf0ec; border-bottom: 1rpx solid #edf0ec; }.item { display: flex; align-items: center; padding: 13rpx 0; }.item-emoji { display: flex; align-items: center; justify-content: center; width: 64rpx; height: 64rpx; margin-right: 13rpx; border-radius: 14rpx; background: #eef3ed; font-size: 31rpx; }.item-info { display: flex; min-width: 0; flex: 1; flex-direction: column; }.name { overflow: hidden; color: #405248; font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }.price { margin-top: 5rpx; color: #7c887f; font-size: 19rpx; }.more-items { padding: 10rpx 0; color: #92a098; font-size: 19rpx; }.order-footer { padding-top: 18rpx; }.total { color: #7c887f; font-size: 21rpx; }.total .price { margin-left: 5rpx; color: #d94a3d; font-size: 29rpx; font-weight: 800; }.action-btn { padding: 12rpx 16rpx; border-radius: 14rpx; background: #eaf3eb; color: #276e49; font-size: 20rpx; }.empty { display: flex; align-items: center; padding-top: 140rpx; flex-direction: column; }.empty-icon { display: flex; align-items: center; justify-content: center; width: 130rpx; height: 130rpx; border-radius: 40rpx; background: #e8efe8; font-size: 60rpx; }.empty-text { margin-top: 22rpx; color: #637268; font-size: 27rpx; font-weight: 700; }.empty-tip { margin-top: 10rpx; color: #9da7a0; font-size: 20rpx; }.go-shopping { margin-top: 28rpx; padding: 18rpx 36rpx; border-radius: 18rpx; background: #185c3a; color: #fff; font-size: 23rpx; }
